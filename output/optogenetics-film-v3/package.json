{
  "name": "optogenetics-film-v3",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "64-second portrait optogenetics film for Douyin, built with Remotion: kinetic on-screen text, line-art motion graphics and a synthesized score, no voiceover",
  "scripts": {
    "studio": "remotion studio",
    "fonts": "python3 scripts/fonts.py",
    "score": "node scripts/score.mjs",
    "sheet": "node scripts/sheet.mjs",
    "render": "remotion render Film out/optogenetics-v3.mp4",
    "cover": "remotion still Cover out/cover.jpg",
    "verify": "node scripts/verify.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run score && npm run render && npm run cover && npm run verify"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/noise": "4.0.534",
    "@remotion/paths": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "esbuild": "0.25.10",
    "puppeteer-core": "24.43.1",
    "typescript": "5.9.3"
  }
}
