[
 {
  "clip": "seg1",
  "a": 0.0,
  "b": 1.4,
  "text": "多给你1000块，"
 },
 {
  "clip": "seg1",
  "a": 1.34,
  "b": 3.56,
  "text": "你会花掉，还是存下来？"
 },
 {
  "clip": "seg1",
  "a": 3.5,
  "b": 5.74,
  "text": "先别急：只发一次，"
 },
 {
  "clip": "seg1",
  "a": 5.68,
  "b": 6.99,
  "text": "和每月都有，"
 },
 {
  "clip": "seg1",
  "a": 6.96,
  "b": 8.89,
  "text": "答案一样吗？"
 },
 {
  "clip": "seg1",
  "a": 9.36,
  "b": 10.92,
  "text": "这个问题背后的道理，"
 },
 {
  "clip": "seg1",
  "a": 10.86,
  "b": 13.02,
  "text": "刚拿了诺贝尔经济学奖。"
 },
 {
  "clip": "seg1",
  "a": 12.96,
  "b": 15.022,
  "text": "获奖的是霍尔和伍德福德。"
 },
 {
  "clip": "seg2",
  "a": 15.042,
  "b": 16.502,
  "text": "霍尔发现："
 },
 {
  "clip": "seg2",
  "a": 16.442,
  "b": 17.742,
  "text": "一次性的钱，"
 },
 {
  "clip": "seg2",
  "a": 17.682,
  "b": 20.412,
  "text": "人们会摊到很多年慢慢花；"
 },
 {
  "clip": "seg2",
  "a": 20.742,
  "b": 23.492,
  "text": "每月都有，才会马上多花。"
 },
 {
  "clip": "seg2",
  "a": 23.502,
  "b": 26.792,
  "text": "能预料的，早就算进去了；"
 },
 {
  "clip": "seg2",
  "a": 27.582,
  "b": 30.063,
  "text": "只有意外，才会让人改主意。"
 },
 {
  "clip": "seg3",
  "a": 30.083,
  "b": 32.363,
  "text": "他还算出：约八成家庭"
 },
 {
  "clip": "seg3",
  "a": 32.303,
  "b": 33.943,
  "text": "会这样往前看，"
 },
 {
  "clip": "seg3",
  "a": 33.883,
  "b": 36.113,
  "text": "两成挣多少花多少。"
 },
 {
  "clip": "seg3",
  "a": 36.103,
  "b": 38.283,
  "text": "另一位得主，伍德福德，"
 },
 {
  "clip": "seg3",
  "a": 38.223,
  "b": 41.043,
  "text": "发现：商家定价也看明天。"
 },
 {
  "clip": "seg3",
  "a": 40.983,
  "b": 43.663,
  "text": "都觉得要涨价，就会提前涨，"
 },
 {
  "clip": "seg3",
  "a": 43.603,
  "b": 45.105,
  "text": "涨价就真来了。"
 },
 {
  "clip": "seg4",
  "a": 46.845,
  "b": 48.985,
  "text": "所以，央行最厉害的武器，"
 },
 {
  "clip": "seg4",
  "a": 48.925,
  "b": 50.165,
  "text": "除了利率，"
 },
 {
  "clip": "seg4",
  "a": 50.105,
  "b": 52.485,
  "text": "还有一句让人相信的话。"
 },
 {
  "clip": "seg4",
  "a": 52.425,
  "b": 53.325,
  "text": "经济的起落，"
 },
 {
  "clip": "seg4",
  "a": 53.265,
  "b": 54.925,
  "text": "就是千千万万个你，"
 },
 {
  "clip": "seg4",
  "a": 54.865,
  "b": 56.385,
  "text": "对明天的判断。"
 },
 {
  "clip": "seg4",
  "a": 56.325,
  "b": 58.465,
  "text": "那1000块，你会花吗？"
 },
 {
  "clip": "seg4",
  "a": 58.405,
  "b": 60.147,
  "text": "评论区说说你是哪种人。"
 }
]
