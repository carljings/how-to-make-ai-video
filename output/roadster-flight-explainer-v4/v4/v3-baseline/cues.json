 "vo": [
  {
   "id": "L01",
   "start": 0.25,
   "text": "比墙还陡，它怎么掉不下来？",
   "display": "title",
   "phrases": [
    {
     "text": "比墙还陡",
     "tone": "white"
    },
    {
     "text": "它怎么掉不下来？",
     "tone": "white"
    }
   ]
  },
  {
   "id": "L02",
   "start": 6.1,
   "text": "风扇抽走车底缝隙里的空气，",
   "display": "caption",
   "phrases": [
    {
     "text": "风扇抽走车底缝隙里的空气",
     "tone": "air"
    }
   ]
  },
  {
   "id": "L03",
   "start": 9.55,
   "text": "外面的空气，就把它压在坡上。",
   "display": "caption",
   "phrases": [
    {
     "text": "外面的空气",
     "tone": "air"
    },
    {
     "text": "就把它压在坡上",
     "tone": "force"
    }
   ]
  },
  {
   "id": "L04",
   "start": 12.75,
   "text": "说是吸，其实是压。",
   "display": "kinetic",
   "phrases": [
    {
     "text": "说是吸",
     "tone": "white"
    },
    {
     "text": "其实是压",
     "tone": "force"
    }
   ]
  },
  {
   "id": "L05",
   "start": 15.15,
   "text": "压紧了，轮胎才抓得住。",
   "display": "caption",
   "phrases": [
    {
     "text": "压紧了",
     "tone": "force"
    },
    {
     "text": "轮胎才抓得住",
     "tone": "white"
    }
   ]
  },
  {
   "id": "L06",
   "start": 19.6,
   "text": "这股力始终压向坡面，哪怕是往上。",
   "display": "caption",
   "phrases": [
    {
     "text": "这股力始终压向坡面",
     "tone": "force"
    },
    {
     "text": "哪怕是往上",
     "tone": "white"
    }
   ]
  },
  {
   "id": "L07",
   "start": 23.45,
   "text": "可坡总有尽头。",
   "display": "caption",
   "phrases": [
    {
     "text": "可坡总有尽头",
     "tone": "white"
    }
   ]
  },
  {
   "id": "L08",
   "start": 25.45,
   "text": "车底下没了坡，就压不住了。",
   "display": "caption",
   "phrases": [
    {
     "text": "车底下没了坡",
     "tone": "white"
    },
    {
     "text": "就压不住了",
     "tone": "force"
    }
   ]
  },
  {
   "id": "L09",
   "start": 28.75,
   "text": "腾空以后，换自带的高压气接力。",
   "display": "caption",
   "phrases": [
    {
     "text": "腾空以后",
     "tone": "white"
    },
    {
     "text": "换自带的高压气接力",
     "tone": "gas"
    }
   ]
  },
  {
   "id": "L10",
   "start": 33.75,
   "text": "气往下喷，车就被往上推。",
   "display": "caption",
   "phrases": [
    {
     "text": "气往下喷",
     "tone": "gas"
    },
    {
     "text": "车就被往上推",
     "tone": "force"
    }
   ]
  },
  {
   "id": "L11a",
   "start": 37.3,
   "text": "另一场演示里，",
   "display": "caption",
   "phrases": [
    {
     "text": "另一场演示里",
     "tone": "white"
    }
   ]
  },
  {
   "id": "L11b",
   "start": 40.85,
   "text": "推力偏离重心，",
   "display": "caption",
   "phrases": [
    {
     "text": "推力偏离重心",
     "tone": "force"
    }
   ]
  },
  {
   "id": "L11c",
   "start": 43.95,
   "text": "它整个翻了过来。",
   "display": "caption",
   "phrases": [
    {
     "text": "它整个翻了过来",
     "tone": "white"
    }
   ]
  },
  {
   "id": "L12",
   "start": 47.9,
   "text": "贴着坡，借的是空气的力；",
