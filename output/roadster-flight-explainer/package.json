{
  "name": "roadster-flight-explainer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "75-second portrait science explainer: Opus 5.5 Blender reconstruction, explanatory animation, Remotion typography and procedural score; Codex integration and technical QA.",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "text:check": "node scripts/text-check.mjs",
    "sound": "node scripts/score.mjs",
    "finalize": "node scripts/finalize.mjs",
    "verify": "node scripts/verify-film.mjs",
    "verify:captions": "node scripts/verify-film.mjs --captions-only",
    "contact": "node scripts/contact.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "esbuild": "0.25.10",
    "typescript": "5.9.3"
  }
}
