{
  "name": "cat-leap",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "一跃 · One Leap: a ginger kitten pounces at a glowing butterfly and leaps through six worlds built from its own room. GPT Image key frames, Seedance 2.5 clips, a Remotion edit with beat-synced transitions, and an original score synthesised in code",
