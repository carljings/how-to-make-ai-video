    "cover": "remotion still Cover out/cover.jpg",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/fonts": "4.0.534",
    "@remotion/media": "4.0.534",
    "@remotion/noise": "4.0.534",
    "@remotion/paths": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "esbuild": "0.25.10",
    "puppeteer-core": "24.43.1",
    "typescript": "5.9.3"
  }
}