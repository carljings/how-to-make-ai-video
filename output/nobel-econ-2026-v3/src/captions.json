[
 {
  "clip": "clipA",
  "a": 0.0,
  "b": 1.48,
  "text": "一句话，"
 },
 {
  "clip": "clipA",
  "a": 1.42,
  "b": 3.45,
  "text": "让整个小镇破产了。"
 },
 {
  "clip": "clipA",
  "a": 3.72,
  "b": 4.9,
  "text": "三天前，"
 },
 {
  "clip": "clipA",
  "a": 4.84,
  "b": 6.46,
  "text": "有人小声说了一句："
 },
 {
  "clip": "clipA",
  "a": 6.4,
  "b": 7.97,
  "text": "“听说明年，"
 },
 {
  "clip": "clipA",
  "a": 8.54,
  "b": 10.22,
  "text": "日子要不好过了”"
 },
 {
  "clip": "clipA",
  "a": 10.16,
  "b": 10.82,
  "text": "这句话，"
 },
 {
  "clip": "clipA",
  "a": 10.76,
  "b": 12.86,
  "text": "一下传遍了整个小镇。"
 },
 {
  "clip": "clipA",
  "a": 12.8,
  "b": 14.14,
  "text": "于是每个人都想："
 },
 {
  "clip": "clipA",
  "a": 14.08,
  "b": 15.022,
  "text": "先省着点吧。"
 },
 {
  "clip": "clipB",
  "a": 15.042,
  "b": 16.422,
  "text": "面馆没客人，"
 },
 {
  "clip": "clipB",
  "a": 16.362,
  "b": 17.542,
  "text": "就不进面粉；"
 },
 {
  "clip": "clipB",
  "a": 17.482,
  "b": 18.702,
  "text": "面粉店没生意，"
 },
 {
  "clip": "clipB",
  "a": 18.642,
  "b": 19.962,
  "text": "就辞掉伙计；"
 },
 {
  "clip": "clipB",
  "a": 19.902,
  "b": 21.142,
  "text": "伙计没了工资，"
 },
 {
  "clip": "clipB",
  "a": 21.082,
  "b": 22.432,
  "text": "更不敢花。"
 },
 {
  "clip": "clipB",
  "a": 23.122,
  "b": 24.162,
  "text": "谣言，"
 },
 {
  "clip": "clipB",
  "a": 24.102,
  "b": 25.772,
  "text": "自己变成了真的。"
 },
 {
  "clip": "clipB",
  "a": 27.082,
  "b": 28.482,
  "text": "这背后的道理，"
 },
 {
  "clip": "clipB",
  "a": 28.422,
  "b": 30.063,
  "text": "刚刚拿了诺贝尔经济学奖。"
 },
 {
  "clip": "clipC",
  "a": 30.083,
  "b": 32.673,
  "text": "得主霍尔和伍德福德发现："
 },
 {
  "clip": "clipC",
  "a": 32.943,
  "b": 34.383,
  "text": "人花不花钱，"
 },
 {
  "clip": "clipC",
  "a": 34.323,
  "b": 36.873,
  "text": "看的是对明天的判断。"
 },
 {
  "clip": "clipC",
  "a": 36.863,
  "b": 38.283,
  "text": "所以今天的央行，"
 },
 {
  "clip": "clipC",
  "a": 38.223,
  "b": 39.423,
  "text": "除了调利率，"
 },
 {
  "clip": "clipC",
  "a": 39.363,
  "b": 41.603,
  "text": "还有一件武器：说话。"
 },
 {
  "clip": "clipC",
  "a": 41.543,
  "b": 43.753,
  "text": "我们会稳住经济！"
 },
 {
  "clip": "clipC",
  "a": 44.183,
  "b": 45.883,
  "text": "一句让人相信的话，"
 },
 {
  "clip": "clipC",
  "a": 45.823,
  "b": 47.763,
  "text": "又让大家敢花钱了。"
 },
 {
  "clip": "clipC",
  "a": 47.703,
  "b": 50.753,
  "text": "下次再听到“日子要不好过了”，"
 },
 {
  "clip": "clipC",
  "a": 50.723,
  "b": 52.105,
  "text": "你会先省钱吗？"
 }
]
